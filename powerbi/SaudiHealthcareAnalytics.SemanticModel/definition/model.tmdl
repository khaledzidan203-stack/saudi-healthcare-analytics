model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["analytics DimGeography","analytics DimNationality","analytics DimSector","analytics DimWorkforceType","analytics DimYear","analytics FactActivity","analytics FactCapacity","analytics FactWorkforceNationality","analytics FactWorkforceSector"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'analytics DimGeography'
ref table 'analytics DimNationality'
ref table 'analytics DimSector'
ref table 'analytics DimWorkforceType'
ref table 'analytics DimYear'
ref table 'analytics FactActivity'
ref table 'analytics FactCapacity'
ref table 'analytics FactWorkforceNationality'
ref table 'analytics FactWorkforceSector'
ref table _Measures

ref cultureInfo en-US

